<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students Details</title>
</head>
<style>
    table , th, td{
        border: 2px solid ;
    }
    th, td{
        
        height: 18px;
    }

    .textspace{
        min-width: 130px;
        max-width: 200px;
    }

    #del-btn{
        height: 100%;
        width: 100%;
        border: none;
        background: transparent;
        color: red;
    }

    #del-btn:hover{
        cursor: pointer;
        text-decoration: line-through;
    }
</style>
<body>
    <table>
        <tr>
            <th>Add. No.:</th>
            <th class="textspace">Name</th>
            <th>Class</th>
            <th class="textspace">City</th>
            <th class="textspace">Email</th>
            <th class="textspace">Birth Date</th>
            <th>Gender</th>
            <th class="textspace">Addmission Date</th>
            <th>Delete Student</th>
        </tr>
        <% for(count of counts) {%>
        <tr>
         <td><%=count.id%></td>
         <td class="textspace"><%=(count.name).toUpperCase()%></td>
         <td><%=count.class%></td>
         <td class="textspace"><%=(count.city).toUpperCase()%></td>
         <td class="textspace"><%=(count.email)%></td>
         <td class="textspace"><%=(count.dob)%></td>
         <td><%=(count.gender).toUpperCase()%></td>
         <td class="textspace"><%=(count.doa)%></td>
         <td><form method="post" action="/del-stu/<%= count.id%>?_method=DELETE">
                <button id="del-btn">Delete Post</button>
            </form></td>
         </tr>
        <% }%>
    </table>
</body>
</html>