<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students Details</title>
</head>
<style>
    table , th, td{
        border: 2px solid ;
    }
    th, td{
        
        height: 18px;
    }

    .textspace{
        min-width: 130px;
        max-width: 200px;
    }
</style>
<body>
    <table>
        <tr>
            <th>Add. No.:</th>
            <th class="textspace">Name</th>
            <th>Class</th>
            <th class="textspace">City</th>
        </tr>
        <% for(count of counts) {%>
        <tr>
         <td><%=count.id%></td>
         <td class="textspace"><%=(count.name).toUpperCase()%></td>
         <td><%=count.class%></td>
         <td class="textspace"><%=(count.city).toUpperCase()%></td>
         </tr>
        <% }%>
    </table>
</body>
</html>