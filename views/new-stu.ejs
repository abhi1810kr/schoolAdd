<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Student</title>
</head>
<link rel="stylesheet" href="/stu-form.css">
<body>
    <form action="/add-student" method="post">
        <table>
            <thead>Student Enrollment Form</thead>
           
            <tr>
                <td><label for="name">Students Name:</label></td>
                <td><input type="text" id="name" name="name" placeholder="Enter fullname" required/></td>
            </tr>
        
            <tr>
                <td><label for="cls">Enter Standard:</label></td>
                <td><input type="number" id="cls" name="cls" max="10" required/></td>
            </tr>
        
            <tr>
                <td><label for="city">Enter Student's City:</label></td>
                <td><input type="text" name="city" id="city" placeholder="Enter city name"></td>
            </tr>
        
            <tr>
                <td><label for="email">Enter email:</label></td>
                <td><input type="email" name="email" id="email" placeholder="Enter email" required /></td>
            </tr>
            <tr>
                <td><label for="dob">Enter DOB:</label></td>
                <td><input type="date" name="dob" id="dob" required /></td>
            </tr>
            <tr>
                <td><p>Select gender:</p></td>
                <td>
                    <input type="radio" name="gender" id="male" value="male" checked />
                    <label for="male">Male</label>
                    <input type="radio" name="gender" id="female" value="female" />
                    <label for="female">Female</label>
                </td>
            </tr>
        
            
        
        </table>

        <button>Add Student</button>
        
    </form>
</body>
</html>