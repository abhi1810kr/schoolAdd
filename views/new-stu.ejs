<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Student</title>
</head>
<body>
    <form action="/add-student" method="post">
        <label for="name">Students Name:</label><br>
        <input type="text" id="name" name="name" placeholder="Enter fullname" required/>
        <br>
        <label for="cls">Enter Standard:</label><br>
        <input type="number" id="cls" name="cls" max="10" required/>
        <br>
        <label for="city">Enter Student's City:</label><br>
        <input type="text" name="city" id="city" placeholder="Enter city name">
        <br>

        <button>Add Student</button>
        
    </form>
</body>
</html>